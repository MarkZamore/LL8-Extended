	quest.5FEC582258880286.title: "В десять раз экономнее"
	quest.6031AB80E15FE4DE.quest_desc: ["&7Диск хранения 1048m вмещает 1,048,576,000 предметов."]
	quest.6031AB80E15FE4DE.quest_subtitle: "Скрафти Диск хранения 1048m"
