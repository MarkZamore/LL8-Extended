	quest.2EB4BB8EF7F8B85B.quest_desc: ["Расширяет рабочую зону некоторых машин."]
	quest.2EB4BB8EF7F8B85B.quest_subtitle: "Скрафти Аддон радиуса 1-го уровня"
	quest.2EB9E425C4552644.quest_subtitle: "Скрафти Ботинки из Ferricore"
	quest.2EDA5A6575CAC4CC.quest_subtitle: "Пусть Тихоня притащит тебе предметы"
	quest.2EE08A93465D22C8.quest_desc: ["&e[!]&7 Варит сплавы всех мастей — и не только их."]
	quest.2EE08A93465D22C8.quest_subtitle: "Скрафти Завод сплавов"
	quest.2EF0F37D5B317851.quest_desc: ["Фильтрует предметы, которые трубы качают в рюкзак и из него, с расширенными настройками фильтра."]
	quest.2EF0F37D5B317851.quest_subtitle: "Скрафти Продвинутое улучшение «Фильтр»."
	quest.2EF336E592021CC4.quest_desc: [
		"Герметичные трубы перекачивают газы: пар, водород, кислород и всё такое."
		""
		"Скорость передачи: 750 mb/t"
	]
	quest.2EF336E592021CC4.quest_subtitle: "Скрафти 8 Герметичных труб"
	quest.2F06EA36874A7450.quest_desc: ["&e[!]&7 Привяжи к нему душу Всполоха (Флакон для душ в Связывателе душ) — и он начнёт гнать FE прямо из лавы."]
	quest.2F06EA36874A7450.quest_subtitle: "Скрафти Двигатель душ"
	quest.2F21FCB7C8DF2FD8.quest_desc: ["Прошёл Серебряную сокровищницу — а досталась мне только эта дурацкая мотыга."]
	quest.2F21FCB7C8DF2FD8.quest_subtitle: "Пройди Серебряную сокровищницу."
	quest.2F264CC69B3D4BEC.quest_desc: ["Меняет погоду. Подробности — в Засаленном блокноте."]
	quest.2F264CC69B3D4BEC.quest_subtitle: "Скрафти скрижаль «Образование Облаков»."
	quest.2F37D67288D3809D.quest_desc: [
		"Оккультист умеет призывать и фамильяров — они помогают ему в странствиях."
		""
		"Дрикрыл — потусторонняя птица, которая накладывает особые эффекты на хозяина, пока он рядом."
		""
		"Совет: есть ритуал призыва дикого попугая — с ним раздобыть жертву для этого ритуала куда проще."
		""
		"Совет №2: призывать нужно именно Фамильяра-дрикрыла — призыв дикого Дрикрыла для этого квеста не засчитается."
	]
	quest.2F37D67288D3809D.title: "Призови Фамильяра-дрикрыла"
	quest.2F41BE66B467D0ED.quest_desc: ["Расширенный зарядник заряжает 4 предмета разом."]
	quest.2F41BE66B467D0ED.quest_subtitle: "Скрафти Расширенный зарядник"
	quest.2F48315407DF0554.quest_desc: [
		"Логистические транспортёры — трубы Mekanism для предметов. Они умнее прочих предметопроводов и очень гибко настраиваются Конфигуратором. "
		""
		"Скорость передачи: 64 предмета / 4 м/с"
	]
	quest.2F48315407DF0554.quest_subtitle: "Скрафти 8 Элитных логистических транспортёров"
	quest.2F5182CB94BE63FC.quest_desc: ["Этот модуль притягивает к тебе выпавшие предметы. В костюм можно поставить до 4 штук."]
	quest.2F5182CB94BE63FC.quest_subtitle: "Скрафти Модуль магнитного притяжения"
	quest.2F6C6DCCE5D0CAF6.quest_desc: ["Ускоряет обработку в некоторых машинах."]
	quest.2F6C6DCCE5D0CAF6.quest_subtitle: "Скрафти Аддон скорости 1-го уровня"
	quest.2F7188B054357B13.quest_subtitle: "Скрафти Нагрудник из Blazegold"
	quest.2F73F6BFCE2540FE.quest_subtitle: "Победи латунного босса."
	quest.2F8A4EB4AD3C7381.quest_subtitle: "Скрафти Бронзовый измельчитель."
	quest.2F8A4EB4AD3C7381.title: "Полуучетверение руды"
	quest.2F981D4547D32C90.quest_desc: [
		"Ставится на воронку и увеличивает её радиус. Подробности — в Book of Natural Aura."
		"Награды: x1 воронка, x1 уровень опыта"
	]
	quest.2F981D4547D32C90.quest_subtitle: "Скрафти Улучшенную воронку."
	quest.2FA078CD0A0E8673.quest_subtitle: "Добудь Окровавленную куклу вуду"
	quest.2FCE8CD3C451A02B.quest_subtitle: "Скрафти полный набор Железодеревянных инструментов."
	quest.2FCE8CD3C451A02B.title: "Орудия из железодерева"
	quest.2FF8614985DF1576.quest_desc: [
		"Потусторонние саженцы поначалу нестабильны: срубишь потустороннее дерево под действием Плода видения демона — и получишь обычные саженцы."
		""
		"Чтобы добыть стабильные Потусторонние саженцы, придётся призвать торговца, который выменяет нам эти драгоценные саженцы. Скоро будет — в одном из следующих квестов, само собой."
	]
	quest.2FF9EF283BDB62D1.quest_desc: ["В один слот влезает в 32 раза больше стаков."]
	quest.2FF9EF283BDB62D1.quest_subtitle: "Скрафти Улучшение «Переполнение V»."
	quest.304237FE544B9A27.quest_desc: [
		"Индукционные ячейки хранят основной запас энергии батареи."
		""
		"Ёмкость: 3.2 GRF"
	]
	quest.304237FE544B9A27.quest_subtitle: "Скрафти Базовую индукционную ячейку"
	quest.3043F936CC5A9B4D.quest_subtitle: "Скрафти Семена цианита"
	quest.3048EF0FAE374580.quest_desc: [
		"Shift + ПКМ по блоку того же типа, что и гнездо, которое ищешь."
		""
		"Пример: ищешь Песочное гнездо — кликни ПКМ либо по Песочному гнезду, либо по блоку песка."
	]
	quest.3048EF0FAE374580.quest_subtitle: "Ищем гнёзда без напряга."
	quest.304EA05DD4B61E96.quest_subtitle: "Добудь Наруч баллистария"
	quest.3061BE81A53B05FC.quest_desc: ["Этот модуль позволяет летать. Управление такое же, как в творческом режиме."]
	quest.3061BE81A53B05FC.quest_subtitle: "Скрафти Модуль гравитационной модуляции"
	quest.30767A1D9F21B173.quest_subtitle: "Скрафти Семена яйца дракона"
	quest.30A28623B5F1225D.quest_desc: [
		"&7Автокрафтер — блок, который собирает предметы по шаблонам."
		""
		"&7В него влезают улучшения скорости — будет крафтить шустрее."
	]
	quest.30A28623B5F1225D.quest_subtitle: "Скрафти Автокрафтер."
	quest.30AEB9B5B87D1AB5.quest_desc: ["&e[!] &7Красит разные блоки (ступеньки, заборы) за FE (энергию)."]
	quest.30AEB9B5B87D1AB5.quest_subtitle: "Скрафти Покрасочный механизм"
	quest.30CC7D43ADDC8D6D.quest_subtitle: "Добудь Пламенный наруч"
	quest.30D92A4F7143EE84.quest_subtitle: "Скрафти Дизельную пилу."
	quest.30D92A4F7143EE84.title: "Техасская резня дизельпилой"
	quest.30DE40A121694F42.quest_desc: ["С этим улучшением пчёлы, умеющие телепортироваться, перестанут телепортироваться, пока живут в улье."]
	quest.30DE40A121694F42.quest_subtitle: "Скрафти улучшение «Антителепортация»."
	quest.30F1498B18DD5711.quest_desc: [
		"> Древний город Энда"
		"> Древний город Незера"
		"> Океанический древний город"
	]
	quest.30F1498B18DD5711.quest_subtitle: "Найди все 3 древних города в RS."
	quest.313C32835A3B766E.quest_subtitle: "Скрафти Семена черепахи"
	quest.31509BD931E06F30.quest_desc: ["Процветающую пчелу получают, использовав Блок процветания на Кристаллической пчеле: просто кликни по ней ПКМ, держа блок в руке."]
	quest.31509BD931E06F30.quest_subtitle: "Добудь Медовые соты процветания."
	quest.31649867BC77CEFF.quest_desc: ["&e[!]&7 Качает воду, если подать энергию и поставить под него блок-источник."]
	quest.31649867BC77CEFF.quest_subtitle: "Скрафти Помпу"
	quest.317028F8B2C0FCFD.quest_desc: [
		"Система QIO — штука довольно крутая. Один из трюков — подружить её с другими модами, например с AE2 и Refined Storage."
		""
		"В AE2 можно поставить МЭ шину хранения так, чтобы её рабочая сторона смотрела на QIO Панель. Тогда МЭ-система из AE2 сможет использовать QIO Ячейки как место для хранения. Так что, смотря сколько у тебя ресурсов, система QIO может оказаться куда более выгодным способом хранить предметы."
	]
	quest.317028F8B2C0FCFD.quest_subtitle: "Информация"
	quest.3186452DAC00B2CB.quest_desc: ["Глиф 3-го уровня — делается на Писарском столе. Подробности — в Засаленном блокноте."]
	quest.3186452DAC00B2CB.quest_subtitle: "Скрафти глиф «Призвать Векса»."
	quest.318FE863FFB73E69.quest_desc: ["Нужна для создания некоторых глифов."]
	quest.318FE863FFB73E69.quest_subtitle: "Скрафти Эссенцию Воздуха."
	quest.3196780ADB0B167A.quest_desc: ["Глиф 3-го уровня — делается на Писарском столе. Подробности — в Засаленном блокноте."]
	quest.3196780ADB0B167A.quest_subtitle: "Скрафти глиф «Захват»."
	quest.319AE4280DFA04E7.quest_desc: ["&7(Лежит в сундуках Тёмной башни.)"]
	quest.319AE4280DFA04E7.quest_subtitle: "Ну на торт же похоже…"
	quest.319B4C94E3D3358C.quest_desc: [
		"Лазерная матрица — единственный способ запустить Термоядерный реактор. На это уходят миллионы RF, так что убедись, что энергии на все эти лазеры у тебя хватает с запасом."
		""
		"Усилитель лазера принимает лазерные лучи и копит их энергию. Сигналом редстоуна ему можно скомандовать выдать её наружу. Вот его и нужно направить на Матрицу лазерного фокуса реактора."
		""
		"Лазерный преломитель принимает лазеры и выпускает их в другом направлении. Так в систему можно добавить больше лазеров и копить энергию быстрее. А ещё им можно копать блоки. "
		""
		"Лазер — это, ну, лазер. Он режет блоки, так что следи, куда он светит. "
	]
	quest.319B4C94E3D3358C.quest_subtitle: "Собери лазерную матрицу"
	quest.31AD21A2BA605EF7.quest_desc: ["MekaSuit можно прокачивать модулями — их устанавливают через &lМодификационную станцию."]
	quest.31AD21A2BA605EF7.quest_subtitle: "Скрафти Ботинки MekaSuit"
	quest.31AE0C270E01A992.quest_subtitle: "Соскреби топором окись с Медной лампы, чтобы она светила ярче."
	quest.31CB830D5B0EF30E.quest_desc: ["Ты, похоже, реально запал на лазеры \\& гаджеты."]
	quest.31CB830D5B0EF30E.quest_subtitle: "Пройди все квесты этой главы."
	quest.3208C183764F96D6.quest_subtitle: "Скрафти Меч, Катану и Мачете из Silent Gear — любые."
	quest.3208C183764F96D6.title: "Коллекционер клинков"
	quest.32262E3C5C691FFF.quest_subtitle: "Войди в портал Энда."
	quest.32394363FFB99200.quest_desc: [
		"Нужны во множестве магических ритуалов. Подробности — в Book of Natural Aura."
		"Награда: x1 знак страха"
	]
	quest.32394363FFB99200.quest_subtitle: "Создай знаки страха."
	quest.32394363FFB99200.title: "Знак страха"
	quest.325A4887108A7216.quest_subtitle: "Скрафти Семена глубинного сланца"
	quest.326432CE8775F659.quest_subtitle: "Добудь Мантию пульсара"
	quest.326DE8ED35956D54.quest_desc: [
		"Сжигает мёд и выдаёт энергию. Мёд можно закачать по трубам, а можно закинуть в интерфейс бутылки, блоки и вёдра с мёдом."
		""
		"Медовый генератор принимает два улучшения: «Продуктивность» снижает расход мёда."
		""
		"А «Скорость» повышает… скорость."
	]
	quest.326DE8ED35956D54.quest_subtitle: "Скрафти Медовый генератор."
	quest.3279E8401A1FA81F.quest_desc: [""]
	quest.3279E8401A1FA81F.quest_subtitle: "Замораживает воду и останавливает лаву."
	quest.32866AC04EEB0959.quest_subtitle: "Добудь Молочные медовые соты."
	quest.3294386B261B4C4E.quest_subtitle: "Скрафти Семена призмарина"
	quest.329CA90EB0637207.quest_subtitle: "Дальность +5 за каждый уровень."
	quest.329DBB55D633E799.quest_desc: [
		"Пора превращать &eАлмазные блоки &fв &eCelestigem&f."
		""
		"Еда для &eVoidshimmer Goo&f — &eЭндер-жемчуг&f или &eПлоды хоруса&f."
		""
		"Как и предыдущие уровни, эта слизь умеет делать ресурсы прошлых уровней, только быстрее."
		""
		"&cP.S. &fВсем инструментам, оружию и броне из &eCelestigem &fи &eсплава Eclipse &fнужна &eэнергия&f, иначе они не работают."
	]
	quest.329DBB55D633E799.quest_subtitle: "Добываем немного Celestigem"
	quest.329DBB55D633E799.title: "Делаем Celestigem"
	quest.32A160B0721064EB.quest_desc: ["QIO Редстоун адаптер следит за содержимым системы QIO и срабатывает по фильтрам, которые ты ему настроишь."]
	quest.32A160B0721064EB.quest_subtitle: "Скрафти QIO Редстоун адаптер"
