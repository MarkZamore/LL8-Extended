	quest.42CBB37CF133FA07.quest_subtitle: "Скрафти Взгляд фейерверка."
	quest.42FB644EC5B67CDA.quest_desc: ["Пока блокируешь им удары, получаешь небольшую прибавку к мане и урону заклинаний. Подробности — в Засаленном блокноте."]
	quest.42FB644EC5B67CDA.quest_subtitle: "Создай Зачарованный щит."
