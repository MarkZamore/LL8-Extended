	quest.26BC59E6C23EDCB5.quest_desc: [
		"Пчёлы, живущие в продвинутых ульях, производят ресурсные соты — закинь их в центрифугу, и она вытащит из них ресурсы."
		""
		"Соты можно спрессовать в блоки сот, чтобы удобнее было хранить."
	]
	quest.26BC59E6C23EDCB5.quest_subtitle: "Добудь Пчелиные соты."
	quest.26D69B7405E332A7.quest_desc: [
