	quest.3F1A03A7B79CFE60.quest_desc: [
		"Соедини этот знак с инструментом на наковальне — и инструмент больше никогда не сломается насовсем. Подробности — в Book of Natural Aura."
		"Награда: x1 Алмазная кирка"
	]
