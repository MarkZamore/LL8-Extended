	quest.3F08EABFD7CD1F63.quest_desc: [
		"Из Tainted Gold Ingot делают магические предметы. Подробности — в Book of Natural Aura."
		"Награды: x1 Фрагмент мешка лута, x1 уровень опыта"
	]
	quest.3F08EABFD7CD1F63.quest_subtitle: "Создай несколько Tainted Gold Ingot."
