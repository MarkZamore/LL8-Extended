	quest.0EEA262B7A9B2E11.quest_desc: ["Антиматерию (Antimatter) выкачивай герметичной трубой прямо в Химический кристаллизатор — там она превращается в гранулы."]
	quest.0EEA262B7A9B2E11.quest_subtitle: "Создай Гранулу антиматерии"
	quest.0EF2A04745E0AD7C.quest_desc: [
		"Occultism — это система ритуальной магии, в центре которой:"
		"- призываемые духи, которые берут на себя самую разную рутину"
		"- хранение огромных гор предметов"
		"- демоны, добывающие руду в пустотных измерениях"
		"- создание мощных зачарованных инструментов и украшений"
		"- поддержка и сильные баффы от фамильяров"
		"- и много-много чего ещё."
		""
		"За подробностями, подсказками и наглядными схемами прямо в мире загляни в выданный тебе Справочник душ"
		"{image:occultism:textures/item/dictionary_of_spirits.png width:100 height:100 align:1}"
	]
	quest.0EF2A04745E0AD7C.quest_subtitle: "Первые шаги"
	quest.0EF2A04745E0AD7C.title: "Во все травкие"
	quest.0F024EF4C3BCBD29.quest_desc: [
