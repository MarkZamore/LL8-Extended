	quest.0000000000000F8C.quest_desc: [
		"Чтобы собрать реактор, нужно 36 блоков реактора."
		""
		"Возьми блоки реактора в руку и посмотри на землю — появится контур 3x3; если он красный, здесь реактор не встанет."
		""
		"И помни: реактор ещё и 4 блока в высоту."
	]
