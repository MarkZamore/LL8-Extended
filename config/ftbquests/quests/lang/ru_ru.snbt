	quest.7E587D157AAF37D6.quest_subtitle: "Работает и как щит, и как планер."
	quest.7E60260515D93FDC.quest_desc: [
		"Эти блоки вместе с другими образуют ритуальную площадку для багрового алтаря. Детали ищи в Book of Natural Aura."
		"Награды: x1 Золотой блок, x1 Loot Bundle Fragment"
	]
	quest.7E60260515D93FDC.quest_subtitle: "Скрафти 8 Golden Nether Bricks."
