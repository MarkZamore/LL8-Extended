	quest.35CBBC81CE410903.quest_desc: ["&7> Тостер волшебным образом превращает хлеб в тосты. &d&kd&b&ks&5&ks &r&7<- магия."]
	quest.35CBBC81CE410903.quest_subtitle: "Скрафти Тостер"
