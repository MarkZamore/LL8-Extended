	quest.58895F42883EAED7.quest_desc: [
		"&a[!] &7Поймай в ведро каждую рыбу из &3@Aquaculture&7 — все до единой."
		""
		"&e[!] &7Как выполнить?"
		"&7Держи их все в инвентаре одновременно."
	]
	quest.58895F42883EAED7.quest_subtitle: "Заведри их всех!"
	quest.58895F42883EAED7.title: "&bЗаведрено!"
	quest.58AC032DAE9DBD2F.quest_subtitle: "Обжёгшись, носитель ненадолго становится неуязвим к огню."
	quest.58AFD5CAB5D852AD.quest_desc: ["Отталкивает предметы поблизости. Подробности — в Рунном планшете."]
	quest.58AFD5CAB5D852AD.quest_subtitle: "Создай Стоячий камень выталкивания."
	quest.58B3AE1CD238E2CF.quest_desc: ["&e[!] &7Книга хранит чертежи и сама работает как чертёж!"]
	quest.58B3AE1CD238E2CF.quest_subtitle: "Скрафти Книгу чертежей."
	quest.58DD9F4BB7F83E26.quest_desc: ["Добавляет в рюкзак камнерез."]
	quest.58DD9F4BB7F83E26.quest_subtitle: "Скрафти Улучшение «Камнерез»."
	quest.58E7050701AC4E84.quest_desc: ["&7> Эту док-станцию можно поставить в мире и пользоваться ею как хранилищем жидкостей, если внутрь вставлен бак."]
	quest.58E7050701AC4E84.quest_subtitle: "Скрафти Tank Dock."
