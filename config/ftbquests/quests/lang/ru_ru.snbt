	quest.0000000000000477.quest_subtitle: "Скрафти Супремиевую эссенцию"
	quest.0000000000000479.quest_subtitle: "Соулиевая семенная основа нужна для семян мобов."
	quest.000000000000047B.quest_subtitle: "Сборочный стол нужен, чтобы навешивать расширения на твои инструменты \\& броню из Mystical Agriculture."
	quest.000000000000047D.quest_desc: ["Вбей '@mysticalagriculture augment' в поиск EMI/JEI — и увидишь все расширения, что тебе доступны."]
	quest.000000000000047D.quest_subtitle: "Не настроенное расширение — основа для любого расширения."
	quest.0000000000000482.quest_desc: [
		"По сути, это каркас для машин Powah."
		""
		"Нужен почти в каждом рецепте машины."
	]
	quest.0000000000000482.quest_subtitle: "Скрафти Диэлектрический корпус."
