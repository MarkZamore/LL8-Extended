	]
	quest.5E636A80CF5B187D.quest_subtitle: "Скрафти Незаметного строителя."
	quest.5E72B2D4C945BD12.quest_desc: [
		"С этим улучшением при каждом визите у опыляющих пчёл берётся маленькая проба."
		""
		"Больно им от этого быть не должно. Пчестное слово."
	]
