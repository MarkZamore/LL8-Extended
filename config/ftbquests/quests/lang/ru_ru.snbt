	file.0000000000000001.title: "TNP Limitless 8"
	quest.000000000000004E.quest_desc: ["&7> Лучше подготовься как следует!"]
	quest.000000000000004E.quest_subtitle: "Призови босса Визера."
	quest.0000000000000050.quest_subtitle: "Свари любое зелье в Зельеварке или чём-то похожем."
	quest.0000000000000052.quest_subtitle: "Собери и поставь Маяк."
	quest.000000000000006B.quest_subtitle: "Отвлеки Пиглинов золотом"
	quest.000000000000006D.quest_subtitle: "Попади в самое яблочко Мишени с расстояния не меньше 30 метров"
	quest.00000000000000B0.quest_subtitle: "Успешно поторгуй с Крестьянином."
	quest.00000000000000B2.quest_subtitle: "Убей любого враждебного монстра"
	quest.00000000000000B4.quest_subtitle: "Убей капитана рейда."
	quest.00000000000000B6.quest_subtitle: "Успешно отбей рейд на деревню."
	quest.00000000000000B8.quest_subtitle: "Попади во что-нибудь стрелой."
	quest.00000000000000BA.quest_subtitle: "Убей по одному ванильному враждебному монстру каждого вида."
	quest.00000000000000BC.quest_subtitle: "Убей Скелета (или его собрата) с расстояния 50+ блоков по горизонтали от того места, где стоишь. (Не по вертикали.)"
	quest.00000000000000BE.quest_subtitle: "Примечание: выбрасывать единственное оружие — так себе идея."
	quest.00000000000000C0.quest_subtitle: "Порази Крестьянина молнией."
	quest.00000000000000C2.quest_subtitle: "Создай Железного голема, чтобы он помог защитить деревню."
	quest.00000000000000C4.quest_subtitle: "Обмани смерть с помощью Тотема бессмертия."
	quest.00000000000000C6.quest_subtitle: "Прыгни в Блок мёда, чтобы погасить падение."
	quest.00000000000000C8.quest_subtitle: "Убей двух Фантомов одной пронзающей стрелой."
	quest.00000000000000CA.quest_subtitle: "Выстрели из арбалета."
	quest.00000000000000CC.quest_subtitle: "Отплати Разбойнику той же монетой!"
	quest.00000000000000CE.quest_subtitle: "Убей пять разных мобов одним выстрелом из арбалета."
	quest.00000000000000D0.quest_subtitle: "Поспи в кровати, чтобы сменить точку возрождения."
	quest.00000000000000D2.quest_subtitle: "Побывай во всех биомах."
	quest.00000000000000D7.quest_subtitle: "Приручи любое животное."
	quest.00000000000000D9.quest_subtitle: "Сыграй в мини-игру \\& вытащи рыбу!"
	quest.00000000000000DB.quest_subtitle: "Шёлковым касанием перенеси Пчелиное гнездо с 3 пчёлами внутри."
	quest.00000000000000DD.quest_subtitle: "Разведи двух животных."
	quest.00000000000000DF.quest_subtitle: "Поставь под Улей Костёр и набери мёд бутылкой, не разозлив пчёл."
	quest.00000000000000E1.quest_subtitle: "Посади семечко и посмотри, как оно растёт."
	quest.00000000000000E3.quest_subtitle: "Съешь всё, что съедобно, — даже то, что тебе явно не на пользу…"
	quest.00000000000000E5.quest_subtitle: "Улучши мотыгу незеритовым слитком, а потом переосмысли свои жизненные решения"
	quest.00000000000000E7.quest_subtitle: "Поймай рыбу… без удочки!"
	quest.00000000000000E9.quest_subtitle: "Приручи кошек всех окрасов!"
	quest.00000000000000EB.quest_subtitle: "Разведи вообще всех животных!"
	quest.00000000000000F0.quest_subtitle: "Убей величественного Дракона Края."
	quest.00000000000000F2.quest_subtitle: "Сбеги с главного острова"
	quest.00000000000000F6.quest_subtitle: "Собери Дыхание дракона в стеклянную бутылочку: кликни ПКМ по фиолетовому облаку, которое оставляет дракон."
	quest.00000000000000F8.quest_desc: ["&e[!] &7Мало одного Яйца дракона? Возроди Дракона Края — и у фонтана в Энде появится ещё одно!"]
	quest.00000000000000F8.quest_subtitle: "Возьми Яйцо дракона в руки"
	quest.00000000000000FA.quest_desc: ["              &7(Найди Город Энда.)"]
	quest.00000000000000FA.quest_subtitle: "Заходи, что может пойти не так?"
	quest.00000000000000FC.quest_subtitle: "Найди элитры… бесконечность — не предел!"
	quest.00000000000000FE.quest_subtitle: "Взлети на 50 блоков от атак Шалкера"
	quest.000000000000010F.quest_subtitle: "Убей Железного голема и стащи его Маки \\& Железные слитки."
	quest.000000000000013C.quest_subtitle: "Убей Зомбифицированного пиглина."
	quest.0000000000000192.quest_desc: ["Самый базовый компонент, без которого не обходится большинство машин и генераторов Mekanism. Делается в Металлургическом наполнителе: Железный слиток + Редстоуновая пыль, Редстоуновый блок или Обогащённая красная пыль."]
	quest.0000000000000192.quest_subtitle: "Создай Наполненный сплав"
	quest.0000000000000194.quest_desc: ["Прокачанная версия Наполненного сплава — нужна некоторым машинам и предметам Mekanism. Делается в Металлургическом наполнителе: Наполненный сплав + Алмазная пыль или Обогащённый алмаз."]
	quest.0000000000000194.quest_subtitle: "Создай Укреплённый сплав"
	quest.0000000000000196.quest_desc: ["Прокачанная версия Укреплённого сплава — нужна некоторым машинам и предметам Mekanism. Делается в Металлургическом наполнителе: Укреплённый сплав + Пыль очищенного обсидиана или Обогащённый обсидиан."]
	quest.0000000000000196.quest_subtitle: "Создай Атомный сплав"
	quest.0000000000000198.quest_desc: ["Базовая схема управления — компонент для крафта, который идёт во множество машин младших уровней."]
	quest.0000000000000198.quest_subtitle: "Создай Базовую схему управления"
	quest.000000000000019A.quest_desc: ["Прокачанная Базовая схема управления — идёт во многие машины и предметы 2-го уровня."]
	quest.000000000000019A.quest_subtitle: "Создай Продвинутую схему управления"
	quest.000000000000019C.quest_desc: ["Прокачанная Продвинутая схема управления — идёт во многие машины и предметы 3-го уровня."]
	quest.000000000000019C.quest_subtitle: "Создай Элитную схему управления"
	quest.000000000000019E.quest_desc: ["Прокачанная Элитная схема управления — идёт во многие машины и предметы 4-го уровня."]
	quest.000000000000019E.quest_subtitle: "Создай Совершенную схему управления"
	quest.00000000000001A0.quest_desc: [
		"Обогащённый углерод используется в Металлургическом наполнителе."
		" "
		"Один Обогащённый углерод даёт наполнителю 80 единиц углерода — столько же, сколько 8 штук угля или 4 штуки древесного угля."
	]
	quest.00000000000001A0.quest_subtitle: "Создай Обогащённый углерод"
	quest.00000000000001A2.quest_desc: [
		"Обогащённая красная пыль используется в Металлургическом наполнителе."
		" "
		"Одна Обогащённая красная пыль даёт Металлургическому наполнителю 80 единиц редстоуна — столько же, сколько 8 штук Редстоуновой пыли."
	]
	quest.00000000000001A2.quest_subtitle: "Создай Обогащённую красную пыль"
	quest.00000000000001A4.quest_desc: [
		"Обогащённый алмаз используется в Металлургическом наполнителе."
		" "
		"Один Обогащённый алмаз даёт Металлургическому наполнителю 80 единиц алмаза — столько же, сколько 8 алмазов."
	]
	quest.00000000000001A4.quest_subtitle: "Создай Обогащённый алмаз"
	quest.00000000000001A6.quest_desc: [
		"Обогащённый обсидиан используется в Металлургическом наполнителе."
		" "
		"Один Обогащённый обсидиан даёт Металлургическому наполнителю 80 единиц обсидиана — столько же, сколько 8 штук Пыли очищенного обсидиана."
	]
	quest.00000000000001A6.quest_subtitle: "Создай Обогащённый обсидиан"
	quest.00000000000001A8.quest_desc: [
		"Обогащённое олово используется в Металлургическом наполнителе."
		" "
		"Одно Обогащённое олово даёт Металлургическому наполнителю 80 единиц олова — столько же, сколько 8 штук Оловянной пыли."
	]
	quest.00000000000001A8.quest_subtitle: "Создай Обогащённое олово"
	quest.00000000000001AA.quest_desc: ["Базовый жидкостный бак вмещает до 14000 mB жидкости. А ещё он умеет работать ведром — достаточно переключить его в режим ведра."]
	quest.00000000000001AA.quest_subtitle: "Скрафти Базовый жидкостный бак"
	quest.00000000000001AC.quest_desc: ["Продвинутый жидкостный бак вмещает до 28000mB жидкости — вдвое больше Базового. И он тоже умеет работать ведром, если переключить его в режим ведра."]
	quest.00000000000001AC.quest_subtitle: "Скрафти Продвинутый жидкостный бак"
	quest.00000000000001AE.quest_desc: [
		"Элитный жидкостный бак — прокачанная версия Продвинутого, вмещает 56000 mB жидкости. Режим ведра включается и выключается по Shift + ПКМ с баком в руке."
		" "
		"Когда режим ведра включён, бак набирает воду и лаву как обычное ведро. Когда выключен — его можно поставить как блок и подвести к нему Механическую трубу."
	]
	quest.00000000000001AE.quest_subtitle: "Скрафти Элитный жидкостный бак"
	quest.00000000000001B0.quest_desc: [
		"Совершенный жидкостный бак — прокачанная версия Элитного, вмещает 112000 mB жидкости. Режим ведра включается и выключается по Shift + ПКМ с баком в руке."
		" "
		"Когда режим ведра включён, бак набирает воду и лаву как обычное ведро. Когда выключен — его можно поставить как блок и подвести к нему Механическую трубу."
	]
	quest.00000000000001B0.quest_subtitle: "Скрафти Совершенный жидкостный бак"
	quest.00000000000001B2.quest_desc: ["Энергетический куб — продвинутая батарейка, которая дружит сразу с несколькими системами энергии."]
	quest.00000000000001B2.quest_subtitle: "Скрафти Базовый энергетический куб"
	quest.00000000000001B4.quest_desc: [
		"Энергетический куб — продвинутая батарейка, которая дружит сразу с несколькими системами энергии."
		" "
		"&oПрокачанная версия Базового энергетического куба."
	]
	quest.00000000000001B4.quest_subtitle: "Скрафти Продвинутый энергетический куб"
	quest.00000000000001B6.quest_desc: [
		"Энергетический куб — продвинутая батарейка, которая дружит сразу с несколькими системами энергии."
		" "
		"&oПрокачанная версия Продвинутого энергетического куба."
	]
	quest.00000000000001B6.quest_subtitle: "Скрафти Элитный энергетический куб"
	quest.00000000000001B8.quest_desc: [
		"Энергетический куб — продвинутая батарейка, которая дружит сразу с несколькими системами энергии."
		" "
		"&oПрокачанная версия Элитного энергетического куба."
	]
	quest.00000000000001B8.quest_subtitle: "Скрафти Совершенный энергетический куб"
	quest.00000000000001BA.quest_desc: ["Солнечная панель превращает солнечный свет в энергию."]
	quest.00000000000001BA.quest_subtitle: "Скрафти Солнечную панель"
	quest.00000000000001BC.quest_desc: [
		"Продвинутая солнечная панель — серьёзно прокачанная версия обычной Солнечной панели."
		" "
		"На её постройку уходит четыре Солнечные панели, зато энергии она выдаёт в шесть раз больше, чем младшая сестрёнка."
		" "
		"А ещё, чтобы её поставить, нужно свободное место 3x3x3 блока."
	]
	quest.00000000000001BC.quest_subtitle: "Скрафти Продвинутую солнечную панель."
	quest.00000000000001BE.quest_desc: [
		"Огромные лопасти Ветрогенератора ловят силу ветра и превращают её в энергию. Каждому Ветрогенератору нужно прилично места — область 1x1x5."
		" "
		"Он выдаёт энергию днём и ночью, в солнце и в дождь, но над ним должно быть открытое небо (над кожухом ротора на верхушке мачты)."
	]
	quest.00000000000001BE.quest_subtitle: "Скрафти Ветрогенератор"
	quest.00000000000001C0.quest_desc: ["Огнемёт — оружие дальнего боя, которое заправляется водородом. Против мобов весьма неплох: прямое попадание струёй наносит урон и поджигает."]
	quest.00000000000001C0.quest_subtitle: "Скрафти Огнемёт"
	quest.00000000000001C2.quest_desc: ["Атомный разборщик — универсальный инструмент Mekanism в формате «всё в одном»: по сути, совершенная электрическая версия пакселя."]
	quest.00000000000001C2.quest_subtitle: "Скрафти Атомный разборщик"
	quest.00000000000001C4.quest_desc: [
		"Электрический лук работает как ванильный лук и стреляет обычными стрелами."
		" "
		"Разница в том, что каждый выстрел не изнашивает лук, а разряжает его. Сядет встроенная батарея — лук перестанет стрелять, и его придётся зарядить, например, в Базовом энергетическом кубе."
	]
	quest.00000000000001C4.quest_subtitle: "Скрафти Электрический лук"
	quest.00000000000001C6.quest_desc: [
		"Бегунки — предмет, с которым ты автоматически взбегаешь на уступы высотой в 1 блок (как Лошадь), а ещё они гасят урон от падения, пока заряжены."
		""
		"Каждое падение съедает у них часть заряда — тем больше, чем выше падал."
	]
	quest.00000000000001C6.quest_subtitle: "Скрафти пару Бегунков"
	quest.00000000000001C8.quest_desc: [
		"Энергетический планшет — портативный перезаряжаемый аккумулятор: вмещает до 1000 kJ энергии, которой потом можно питать другие устройства."
		" "
		"А ещё он ингредиент во многих рецептах."
	]
	quest.00000000000001C8.quest_subtitle: "Скрафти Энергетический планшет"
	quest.00000000000001CE.quest_desc: ["Базовый ящик — блок-хранилище на 4096 штук одного предмета. Сломаешь — содержимое никуда не денется."]
	quest.00000000000001CE.quest_subtitle: "Скрафти Базовый ящик"
	quest.00000000000001D0.quest_desc: ["Продвинутый ящик — блок-хранилище на 8192 штуки одного предмета. Сломаешь — содержимое никуда не денется."]
	quest.00000000000001D0.quest_subtitle: "Скрафти Продвинутый ящик"
	quest.00000000000001D2.quest_desc: ["Элитный ящик — блок-хранилище на 32 768 штук одного предмета. Сломаешь — содержимое никуда не денется."]
	quest.00000000000001D2.quest_subtitle: "Скрафти Элитный ящик"
	quest.00000000000001D4.quest_desc: ["Совершенный ящик — блок-хранилище на 262 144 штуки одного предмета. Сломаешь — содержимое никуда не денется."]
	quest.00000000000001D4.quest_subtitle: "Скрафти Совершенный ящик"
	quest.00000000000001D6.quest_desc: ["Химические баки — это «батарейки» Mekanism для газов. Их можно ставить как блок, и они дружат с Герметичными трубами. Всего четыре уровня, каждый следующий — больше ёмкость и быстрее выдача."]
	quest.00000000000001D6.quest_subtitle: "Скрафти Базовый химический бак"
	quest.00000000000001D8.quest_desc: ["Химические баки — это «батарейки» Mekanism для газов. Их можно ставить как блок, и они дружат с Герметичными трубами. Всего четыре уровня, каждый следующий — больше ёмкость и быстрее выдача."]
	quest.00000000000001D8.quest_subtitle: "Скрафти Продвинутый химический бак"
	quest.00000000000001DA.quest_desc: ["Химические баки — это «батарейки» Mekanism для газов. Их можно ставить как блок, и они дружат с Герметичными трубами. Всего четыре уровня, каждый следующий — больше ёмкость и быстрее выдача."]
	quest.00000000000001DA.quest_subtitle: "Скрафти Элитный химический бак"
	quest.00000000000001DC.quest_desc: ["Химические баки — это «батарейки» Mekanism для газов. Их можно ставить как блок, и они дружат с Герметичными трубами. Всего четыре уровня, каждый следующий — больше ёмкость и быстрее выдача."]
	quest.00000000000001DC.quest_subtitle: "Скрафти Совершенный химический бак"
	quest.00000000000001E0.quest_desc: [
		"Универсальные провода — так в Mekanism передают энергию."
		" "
		"Пропускная способность: 3.20 kFE/t"
	]
	quest.00000000000001E0.quest_subtitle: "Скрафти x8 Базовых универсальных проводов"
	quest.00000000000001E0.title: "Базовый универсальный провод"
	quest.00000000000001E2.quest_desc: [
		"Универсальные провода — так в Mekanism передают энергию."
		" "
		"Пропускная способность: 51.20 kFE/t"
	]
	quest.00000000000001E2.quest_subtitle: "Скрафти x8 Продвинутых универсальных проводов"
	quest.00000000000001E2.title: "Продвинутый универсальный провод"
	quest.00000000000001E4.quest_desc: [
		"Универсальные провода — так в Mekanism передают энергию."
		" "
		"Пропускная способность: 409.60 kFE/t"
	]
	quest.00000000000001E4.quest_subtitle: "Скрафти x8 Элитных универсальных проводов"
	quest.00000000000001E4.title: "Элитный универсальный провод"
	quest.00000000000001E6.quest_desc: [
		"Универсальные провода — так в Mekanism передают энергию."
		" "
		"Пропускная способность: 3.27 MFE/t"
	]
	quest.00000000000001E6.quest_subtitle: "Скрафти x8 Совершенных универсальных проводов"
	quest.00000000000001E6.title: "Совершенный универсальный провод"
	quest.00000000000001E8.quest_desc: ["Улучшение для машин Mekanism: заставляет их обрабатывать предметы быстрее. В каждую машину Mekanism влезает 8 таких улучшений."]
	quest.00000000000001E8.quest_subtitle: "Скрафти Улучшение: Скорость"
	quest.00000000000001EA.quest_desc: ["Улучшение: Энергия — увеличивает запас энергии у машины Mekanism со слотом под улучшения, а заодно снижает её энергопотребление."]
	quest.00000000000001EA.quest_subtitle: "Скрафти Улучшение: Энергия"
	quest.00000000000001EE.quest_desc: ["Улучшение для машин Mekanism: делает их чуть потише. Воткни все 4 — и машины замолчат совсем."]
	quest.00000000000001EE.quest_subtitle: "Скрафти Улучшение: Шум"
	quest.00000000000001F0.quest_desc: ["Chemical Upgrade (оно же газовое улучшение) повышает эффективность расхода газа у тех машин Mekanism, которые его поддерживают."]
	quest.00000000000001F0.quest_subtitle: "Скрафти Chemical Upgrade"
	quest.00000000000001F2.quest_desc: ["Улучшение: Якорь — держит чанк с машиной, в которую оно вставлено, прогруженным. Полезно для Цифрового шахтёра или Телепорта — им для нормальной работы нужен прогруженный чанк."]
	quest.00000000000001F2.quest_subtitle: "Скрафти Улучшение: Якорь"
	quest.00000000000001F6.quest_desc: ["Механизмы (Factories) — продвинутые версии базовых машин, заточенные под переработку ресурсов в промышленных масштабах"]
	quest.00000000000001F6.quest_subtitle: "Скрафти Базовый плавящий механизм"
	quest.00000000000001F8.quest_desc: ["Механизмы (Factories) — продвинутые версии базовых машин, заточенные под переработку ресурсов в промышленных масштабах"]
	quest.00000000000001F8.quest_subtitle: "Скрафти Базовый обогащающий механизм"
