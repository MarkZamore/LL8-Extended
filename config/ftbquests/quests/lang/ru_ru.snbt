	quest.5963B8D1FB6DB6D1.quest_desc: [
		"Работает с одной-четырьмя Лазерными дрелями и выдаёт руду."
		""
		"Лазерные линзы повышают или понижают шанс конкретных руд."
	]
	quest.5963B8D1FB6DB6D1.quest_subtitle: "Скрафти Лазерную основу."
	quest.597B75B975784201.quest_desc: [
		"От этого порошка животные размножаются, а из яиц кто-то вылупляется. Больше подробностей — в Book of Natural Aura."
		"Награда: x2 Яйцо призыва свиньи"
	]
	quest.597B75B975784201.quest_subtitle: "Создай Порошок плодородия."
	quest.597B75B975784201.title: "Порошок плодородия"
	quest.598EEE2E20A351DE.quest_subtitle: "Возьми на Поводок Лягушку каждого вида"
	quest.5992E01C4268CF7B.quest_subtitle: "Собери МЭ терминал"
	quest.5995B93DC0EF28EC.quest_subtitle: "Подбей одежду мягкой шерстью Альфа-йети — она убережёт тебя от холода Сумеречного ледника."
	quest.59975BA101BAAD0D.quest_desc: ["Глиф 2-го уровня — делается на Писарском столе. Подробности — в Засаленном блокноте."]
