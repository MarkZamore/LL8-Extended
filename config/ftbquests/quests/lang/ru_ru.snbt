	quest.7DE030551785F580.quest_subtitle: "Скрафти Автокрафтер"
	quest.7DF276E761B963DD.quest_desc: ["Позволяет пользоваться терминалами и крафт-устройствами из других измерений."]
	quest.7DF276E761B963DD.quest_subtitle: "Скрафти Плату измерения"
