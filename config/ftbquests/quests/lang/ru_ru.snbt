	quest.000000000000051B.quest_desc: ["&oПлавит 12 предметов."]
	quest.000000000000051B.quest_subtitle: "Скрафти Инфериевый уголь"
	quest.000000000000051D.quest_desc: ["&oПлавит 24 предмета."]
	quest.000000000000051D.quest_subtitle: "Скрафти Прудентиевый уголь"
