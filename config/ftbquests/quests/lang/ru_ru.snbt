	quest.599F7CD899DDEAAB.quest_desc: [
		"Древние деревья выращивают, чтобы восстановить ауру в округе. Больше подробностей — в Book of Natural Aura."
		"Награды: x1 Loot Bundle Fragment, x1 уровень опыта"
	]
	quest.599F7CD899DDEAAB.quest_subtitle: "Создай Древний саженец."
	quest.599F7CD899DDEAAB.title: "Древний саженец"
	quest.59B6F746D82EC926.quest_desc: [
		"Флюорит можно только добыть под землёй или вырастить через Mystical Agriculture. "
		""
		"Его нужно будет соединить с Серной кислотой, которую ты сделал раньше, и получить плавиковую кислоту."
	]
	quest.59B6F746D82EC926.quest_subtitle: "Добудь флюорит"
	quest.59D4B66D1554D515.quest_desc: ["В один слот влезает в 16 раз больше стаков."]
	quest.59D4B66D1554D515.quest_subtitle: "Скрафти Улучшение «Переполнение IV»."
	quest.5A39A085322805C5.quest_desc: ["Одноразовый телепорт. Подробности — в Засаленном блокноте."]
	quest.5A39A085322805C5.quest_subtitle: "Скрафти Варп-свиток."
	quest.5A448C9964FD60F8.quest_subtitle: "Добудь Эхо-перчатку"
	quest.5A5778F40E4B4219.quest_subtitle: "Скрафти Поножи из Celestigem"
	quest.5A58A0C1C063B9CB.quest_subtitle: "Дальность +5 за каждый уровень."
	quest.5A6EC257796772CF.quest_subtitle: "Добудь вкусненькую бутылочку мёда."
	quest.5A79FED3BF669339.quest_subtitle: "Добудь Аметистовые медовые соты."
	quest.5AA77D12B8AA2150.quest_desc: [
		"&7Беспроводной передатчик раздаёт сигнал беспроводным предметам сети Refined Storage."
		""
		"&7Базовая дальность — 16 блоков, но улучшения дальности её поднимают."
	]
	quest.5AA77D12B8AA2150.quest_subtitle: "Скрафти Беспроводной передатчик."
	quest.5AA7B6CF4B85C8CF.quest_desc: [
		"Нужны во многих магических ритуалах. Больше подробностей — в Book of Natural Aura."
		"Награда: x1 Знак гнева"
	]
	quest.5AA7B6CF4B85C8CF.quest_subtitle: "Создай Знаки гнева."
