	quest.3F3BE70179C91BB8.quest_desc: ["Глиф 2-го уровня — делается на Писарском столе. Подробности — в Засаленном блокноте."]
	quest.3F3BE70179C91BB8.quest_subtitle: "Скрафти глиф «Исцеление»."
	quest.3F57F0B2DA4C5E35.quest_desc: ["Время от времени вешает на тебя случайный положительный эффект — ненадолго. Подробности — в Засаленном блокноте."]
	quest.3F57F0B2DA4C5E35.quest_subtitle: "Создай Пояс Нестабильных Даров."
	quest.3F5B9025456B88D5.quest_subtitle: "Скрафти Семена олова"
	quest.3F60950667A335BD.quest_desc: [
		"Волшебное ведро, которое переносит цвет с одного блока на другой. Детали ищи в Book of Natural Aura."
		"Награды: x8 Белое стекло, x8 Белая шерсть"
	]
	quest.3F60950667A335BD.quest_subtitle: "Скрафти Ведро бесконечного цвета."
